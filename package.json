{
  "name": "nullray",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check && vite build",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "oxlint && tsc --project tsconfig.node.json && tsc --project src/runtime/worker/tsconfig.json",
    "test": "vitest run --project cpu",
    "test:gpu": "vitest run --project gpu",
    "test:ui": "vitest run --project browser",
    "test:visual": "vitest run --project visual",
    "bench": "vitest bench --run --project 'cpu*'",
    "bench:gpu": "vitest bench --run --project 'gpu*'"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/web": "^0.0.356",
    "@types/webworker": "^0.0.80",
    "@vitest/browser-playwright": "^5.0.0",
    "fast-check": "^4.10.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
