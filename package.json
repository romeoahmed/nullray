{
  "name": "nullray",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check && vite build",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "oxlint && tsc --project tsconfig.node.json && tsc --project src/runtime/worker/tsconfig.json && pnpm check:css",
    "check:css": "stylelint 'src/**/*.css'",
    "test": "vitest run --project cpu",
    "test:gpu": "vitest run --project gpu",
    "test:ui": "vitest run --project browser",
    "test:visual": "vitest run --project visual",
    "bench": "vitest bench --run --project 'cpu*'",
    "bench:gpu": "vitest bench --run --project 'gpu*'"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/web": "^0.0.357",
    "@types/webworker": "^0.0.81",
    "@vitest/browser-playwright": "^5.0.2",
    "fast-check": "^4.10.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
